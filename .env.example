# =============================================================================
# ig-reels-app environment template
# =============================================================================
# 1. Copy this file:   cp .env.example .env.local
# 2. Fill in real values in .env.local. That file is git-ignored; NEVER commit it.
# 3. Restart `npm run dev`. Values are validated at startup by lib/envSchema.ts
#    and the server refuses to start if any value is missing or malformed.
#
# Rules for every secret below:
#   - Server-side only. Never prefix with NEXT_PUBLIC_ (that would ship the
#     value to every visitor's browser).
#   - No quotes, no spaces, no trailing newline.
#   - Use separate keys for local dev, CI and production, so one leaked key
#     can be revoked without breaking the others.
#   - If a key is ever committed, pasted in chat or shared: revoke it at the
#     provider FIRST, then remove it from git history (e.g. git-filter-repo).
#
# Leaving a variable empty (KEY=) is the same as not setting it.
# =============================================================================

# -----------------------------------------------------------------------------
# AI model (summarises each video into recommendations): OPTIONAL
# -----------------------------------------------------------------------------
# Leave AI_PROVIDER empty to run in demo mode with labelled sample data.
# Set it, and AI_MODEL (+ AI_API_KEY unless local) become required.
#
# AI_PROVIDER   Example AI_MODEL           Get a key
# -----------   ------------------------   ------------------------------------
# anthropic     claude-opus-5-5            https://console.anthropic.com
# openai        gpt-5-mini                 https://platform.openai.com/api-keys
# gemini        gemini-2.5-flash           https://aistudio.google.com/apikey
# sambanova     gpt-oss-120b               https://cloud.sambanova.ai
# groq          llama-3.3-70b-versatile    https://console.groq.com/keys
# openrouter    meta-llama/llama-3.3-70b-instruct  https://openrouter.ai/keys
# mistral       mistral-small-latest       https://console.mistral.ai
# deepseek      deepseek-chat              https://platform.deepseek.com
# ollama        llama3.1:8b                no key; runs on your machine
# custom        (your model)               any OpenAI-compatible API + AI_BASE_URL
#
# Model names change often. Check your provider's model list for the exact id.
AI_PROVIDER=

# Model id exactly as your provider spells it.
AI_MODEL=

# API key from your provider. Not needed for ollama.
AI_API_KEY=

# Optional. Overrides the provider's default endpoint (required for "custom").
# Must be https://, except http://localhost for local servers.
# Example: http://localhost:1234/v1 for LM Studio.
AI_BASE_URL=

# -----------------------------------------------------------------------------
# Apify (Instagram Reel + TikTok caption ingestion): OPTIONAL
# -----------------------------------------------------------------------------
# Unset    -> video text is simulated (only useful for testing the pipeline).
# Set      -> captions are fetched with the apify~instagram-scraper and
#             clockworks~tiktok-scraper actors (both billed to your Apify account).
# Format   -> starts with "apify_api_" followed by 20+ letters/digits.
# Scope    -> prefer a scoped token restricted to those two actors.
# Get one  -> https://console.apify.com > Settings > API & Integrations
APIFY_API_TOKEN=

# -----------------------------------------------------------------------------
# Google Maps (find each place + export for Google My Maps): OPTIONAL
# -----------------------------------------------------------------------------
# Unset    -> the "Put it on a map" panel explains how to turn it on.
# Set      -> each extracted place is looked up with the Places API (New)
#             Text Search. Every lookup is billable after Google's free tier.
# Format   -> a Google Cloud API key starting with "AIza" (39 characters).
# Get one  -> https://console.cloud.google.com > APIs & Services:
#             1. Enable "Places API (New)"
#             2. Credentials > Create credentials > API key
#             3. Restrict the key to "Places API (New)" only, and set a
#                budget alert under Billing so a mistake can't run up a bill.
GOOGLE_MAPS_API_KEY=
